# ─── Application ─────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────
# Matches the docker-compose.yml credentials for local dev.
# Replace with your hosted DB URL in staging/production.
DATABASE_URL="postgresql://delivery_buddy:delivery_buddy_secret@localhost:5433/delivery_buddy_db?schema=public"

# ─── Redis ────────────────────────────────────────────────────
# Matches the docker-compose.yml Redis service for local dev.
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
